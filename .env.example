# Copy this file to .env (gitignored) and fill in the values.
# docker compose reads .env automatically; the backend needs the variables exported
# (see "Configuration" in README.md).

# --- Keycloak / backend -------------------------------------------------------

# Required. Secret of the modularhub-backend confidential client. Keycloak sets it when
# importing the realm and the backend uses it to call the Keycloak admin API.
# Any value works locally, it only has to be the same for both.
MODULARHUB_BACKEND_CLIENT_SECRET=change-me

# --- Database (backend only) ---------------------------------------------------

# Optional. Connection to Postgres used by the backend. The defaults match the
# container started by compose.yaml, whose credentials are hardcoded there.
# POSTGRES_DB=modularhub
# POSTGRES_USER=modularhub
# POSTGRES_PASSWORD=modularhub

# --- Email (Keycloak SMTP) -----------------------------------------------------
# Emails (e.g. password reset) are sent by Keycloak, not by the backend.
# By default they go to the Mailpit container started by compose.yaml: nothing is
# delivered for real and every message can be read at http://localhost:8025.
# To use a real provider (e.g. Mailjet), uncomment and set the values below.
# These values are applied only when Keycloak imports the realm, i.e. when the
# modularhub realm does not exist yet.

# SMTP server host and port. Default: mailpit / 1025.
# MODULARHUB_SMTP_HOST=in-v3.mailjet.com
# MODULARHUB_SMTP_PORT=587

# Sender address of the emails. Default: noreply@modularhub.local.
# MODULARHUB_SMTP_FROM=noreply@example.com

# Whether the SMTP server requires authentication, and its credentials.
# Default: false, with empty credentials.
# MODULARHUB_SMTP_AUTH=true
# MODULARHUB_SMTP_USER=
# MODULARHUB_SMTP_PASSWORD=

# Encryption: STARTTLS (usually port 587) or SSL/TLS (usually port 465).
# Default: both false.
# MODULARHUB_SMTP_STARTTLS=true
# MODULARHUB_SMTP_SSL=false
